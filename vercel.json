{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "fluid": true,
  "functions": {
    "api/**/*.ts": {"maxDuration": 120}
  },
  "headers": [
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
